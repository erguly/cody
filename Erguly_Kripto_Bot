    def _on_timeframe_selected_wrapper(self, *args):
        """ Zaman dilimi seçimi için trace callback sarmalayıcısı """
        # Zaman dilimi değişikliğini ayrı bir thread'de yap ki GUI donmasın
        # Not: GUI elemanlarını (combobox disable/enable) yönetmek için yine
        # self.root.after gerekebilir.
        # Şimdilik basit tutalım, doğrudan çağıralım ama uzun sürebilir.
        # Daha iyisi: Bir thread başlatıp o thread içinden GUI'yi güncellemek.

        # Seçilen değeri al (StringVar zaten güncellenmiş olmalı)
        new_timeframe = self.selected_timeframe.get()
        logging.info(f"Zaman dilimi değiştiriliyor: {new_timeframe}")

        # Yüklenmesi istenen zaman dilimini GÜNCELLE (thread başlamadan ÖNCE)
        self.currently_requested_timeframe = new_timeframe

        # Değişikliği işleyecek fonksiyonu çağır (thread içinde daha iyi olabilir)
        # Thread kullanmak GUI'nin donmasını engeller ama karmaşıklığı artırır.
        # Şimdilik doğrudan çağıralım:
        threading.Thread(target=self._handle_timeframe_change, args=(new_timeframe,), daemon=True).start()

    def _handle_timeframe_change(self, new_timeframe: str):
        """ Zaman dilimi değişikliğini işler (WebSocket durdurma, veri temizleme, yeniden başlatma) """
        # GUI elemanını devre dışı bırak (ana thread üzerinden)
        self.root.after(0, lambda: self.timeframe_combobox.config(state="disabled"))
        
        # 1. Mevcut WebSocket'i durdur
        if self.ws:
            logging.info("Mevcut WebSocket bağlantısı durduruluyor...")
            self.stop_ws_flag.set() # Durdurma işaretini set et
            self.ws.close()
            if self.ws_thread and self.ws_thread.is_alive():
                self.ws_thread.join(timeout=5) # Thread'in bitmesini bekle (max 5sn)
            if self.ws_thread and self.ws_thread.is_alive():
                 logging.warning("WebSocket thread'i zamanında durmadı.")
            self.ws = None
            self.ws_thread = None
            self.stop_ws_flag.clear() # İşareti temizle
            logging.info("WebSocket bağlantısı durduruldu.")

        # 2. Verileri ve durumu temizle
        logging.info("Mevcut veriler temizleniyor...")
        self.data.clear()
        self.scores.clear()
        self.ratios.clear()
        self.signals.clear()
        self.signal_history.clear()
        self.active_signals_to_track.clear()
        self.symbol_to_tree_item.clear()
        self.ml_predictions.clear() # ML tahminlerini de temizle
        self.initial_load_complete.clear() # Yükleme tamamlanmadı olarak işaretle
        # GUI tablosunu temizle (ana thread üzerinden)
        self.root.after(0, lambda: [self.tree_scanner.delete(i) for i in self.tree_scanner.get_children()])

        # 3. Yeni zaman dilimi için başlangıç verilerini yükle
        logging.info(f"{new_timeframe} için başlangıç verileri yükleniyor...")
        initial_load_thread = threading.Thread(target=self.update_initial_data, args=(new_timeframe,), daemon=True)
        initial_load_thread.start()
        
        logging.info("Başlangıç veri yükleme thread'i başlatıldı. Yükleme bitince WebSocket başlayacak.")

    def export_signals_to_csv(self, filename: str = "signals_analysis_export.csv"):
        """Sinyal ve sonuç verilerini CSV dosyasına aktarır."""
        logging.info(f"Sinyal ve sonuç verileri '{filename}' dosyasına aktarılıyor...")
        
        export_data = self.get_trade_outcomes_for_export(limit=10000) # Daha fazla veri çekelim

        if not export_data:
            logging.warning("Aktarılacak sinyal/sonuç verisi bulunamadı.")
            # GUI üzerinden çağrıldıysa kullanıcıyı bilgilendir
            try:
                from tkinter import messagebox
                messagebox.showwarning("Export Failed", "No signal/outcome data found in the database to export.")
            except ImportError:
                 pass # GUI yoksa devam et
            return

        try:
            # İlk kaydın anahtarlarını başlık olarak kullan (tüm sütunları içerir)
            headers = list(export_data[0].keys())
            
            # Dosya yolunu proje dizini ile birleştir (isteğe bağlı)
            # file_path = os.path.join(os.path.dirname(__file__), filename) # Script ile aynı dizine kaydet
            file_path = filename # Veya direkt çalışma dizinine kaydet
            
            with open(file_path, 'w', newline='', encoding='utf-8') as csvfile:
                writer = csv.DictWriter(csvfile, fieldnames=headers)
                writer.writeheader()
                writer.writerows(export_data)
                
            logging.info(f"{len(export_data)} kayıt başarıyla '{file_path}' dosyasına aktarıldı.")
            # Kullanıcıyı bilgilendir
            try:
                from tkinter import messagebox
                messagebox.showinfo("Export Successful", f"{len(export_data)} records exported successfully to:\n{os.path.abspath(file_path)}")
            except ImportError:
                pass 
        except IOError as e:
            logging.error(f"CSV dosyası yazılırken hata oluştu: {e}")
            try:
                from tkinter import messagebox
                messagebox.showerror("Export Error", f"Could not write to file {filename}.\n{e}")
            except ImportError:
                pass 
        except Exception as e:
            logging.error(f"CSV aktarma sırasında beklenmedik hata: {e}", exc_info=True)
            try:
                from tkinter import messagebox
                messagebox.showerror("Export Error", f"An unexpected error occurred during export.\n{e}")
            except ImportError:
                pass

    def get_trade_outcomes_for_export(self, limit: int = 5000) -> List[Dict[str, Any]]:
        """Veritabanından sinyal ve sonuç verilerini CSV export için çeker."""
        conn = self._connect_db()
        if conn is None: return []
        
        # LEFT JOIN kullanarak tüm sinyalleri ve eşleşen sonuçları al
        # outcomes tablosundaki sütun isimlerinin signals ile çakışmaması için alias kullanılabilir
        # Şimdilik basit tutalım, sütun isimleri farklı varsayıyoruz (outcome_timestamp vs timestamp)
        sql = ''' 
        SELECT 
            s.*, -- signals tablosundaki tüm sütunlar
            o.outcome_timestamp,
            o.achieved_price,
            o.time_to_target_s
        FROM signals s
        LEFT JOIN outcomes o ON o.signal_id = s.id 
        ORDER BY s.timestamp DESC -- En son sinyaller önce
        LIMIT ?
        '''
        trades_data = []
        try:
            cursor = conn.cursor()
            cursor.execute(sql, (limit,))
            rows = cursor.fetchall()
            # sqlite3.Row nesnelerini dict'e çevir
            for row in rows:
                trades_data.append(dict(row))
            logging.info(f"{len(trades_data)} adet sinyal/sonuç verisi export için veritabanından çekildi (Limit: {limit}).")
            return trades_data
        except sqlite3.Error as e:
            logging.error(f"SQLite export verisi çekme hatası: {e}")
            return []
        finally:
            if conn:
                conn.close()

    def get_trade_outcomes(self, limit: int = 200) -> List[Dict[str, Any]]:
        """Veritabanından tamamlanmış veya başarısız olmuş işlemlerin sonuçlarını çeker."""
        conn = self._connect_db()
        if conn is None: return []
        sql = ''' 
        SELECT 
            s.timestamp as signal_timestamp,
            s.symbol,
            s.signal_type,
            s.signal_price,
            s.score,
            s.ratio as signal_ratio, -- Sinyal anındaki ratio
            s.is_confirmed_orig, -- Orijinal teyit durumu
            s.volume_ok,
            s.momentum_perc_ok,
            s.momentum_abs_ok,
            s.tracking_status, -- COMPLETED / FAILED
            o.outcome_timestamp,
            o.achieved_price, -- Hedef fiyat veya takip sonu fiyatı
            o.max_high_price_after_signal,
            o.max_percentage_gain,
            o.time_to_target_s -- Süre (saniye)
        FROM signals s
        LEFT JOIN outcomes o ON o.signal_id = s.id 
        WHERE s.tracking_status IN ('COMPLETED', 'FAILED')
        ORDER BY o.outcome_timestamp DESC NULLS LAST, s.timestamp DESC 
        LIMIT ?
        '''
        trades = []
        try:
            cursor = conn.cursor()
            cursor.execute(sql, (limit,))
            rows = cursor.fetchall()
            for row in rows:
                trades.append(dict(row))
            logging.info(f"{len(trades)} adet işlem sonucu veritabanından çekildi (Limit: {limit}).")
            return trades
        except sqlite3.Error as e:
            logging.error(f"SQLite işlem sonucu çekme hatası: {e}")
            return []
        finally:
            if conn:
                conn.close()

    def refresh_trade_outcomes_tab(self):
        """Trade Outcomes sekmesindeki tabloyu veritabanından günceller."""
        # Önce mevcut verileri temizle
        for item in self.tree_trades.get_children():
            self.tree_trades.delete(item)
            
        # Veritabanından işlem sonuçlarını çek
        trade_outcomes = self.get_trade_outcomes(limit=200) # Son 200 sonucu göster
        
        # Tabloyu doldur
        for trade in trade_outcomes:
            # Verileri formatla
            signal_price_formatted = f"{trade.get('signal_price', 0.0):.5f}"
            max_gain_formatted = f"{trade.get('max_percentage_gain', 0.0):.2f}" if trade.get('max_percentage_gain') is not None else '-'
            max_high_formatted = f"{trade.get('max_high_price_after_signal', 0.0):.5f}" if trade.get('max_high_price_after_signal') is not None else '-'
            duration_formatted = f"{trade.get('time_to_target_s', 0.0):.0f}" if trade.get('time_to_target_s') is not None else '-'
            
            values = (
                trade.get('signal_timestamp', '-'),
                trade.get('symbol', '-'),
                trade.get('signal_type', '-'),
                trade.get('tracking_status', '-'), # Status
                signal_price_formatted,
                max_gain_formatted, # Max % Gain
                max_high_formatted, # Max High
                trade.get('outcome_timestamp', '-'),
                duration_formatted # Duration
            )
            self.tree_trades.insert('', 'end', values=values)
        logging.info("Trade outcomes tablosu güncellendi.")

    def prepare_ml_data(self) -> pd.DataFrame:
        """Queries DB, prepares features and target for ML model."""
        logging.info("Preparing data for ML model...")
        conn = self._connect_db()
        if conn is None: 
            return pd.DataFrame() # Return empty DataFrame on DB error

        # Query signals table for features
        # Select features potentially useful for prediction
        sql_signals = """
        SELECT 
            id, symbol, signal_type, score, ratio AS signal_ratio, 
            signal_price, signal_volume, confirm_volume, 
            signal_momentum_perc, confirm_momentum_perc,
            signal_abs_price_change, confirm_abs_price_change,
            volume_ok, momentum_perc_ok, momentum_abs_ok, 
            is_confirmed_orig, tracking_status 
        FROM signals
        WHERE tracking_status IN ('COMPLETED', 'FAILED') -- Only use decided outcomes
        ORDER BY timestamp DESC 
        LIMIT 5000 -- Limit data size for initial training
        """ 
        try:
            signals_df = pd.read_sql_query(sql_signals, conn)
            logging.info(f"Fetched {len(signals_df)} signals with 'COMPLETED' or 'FAILED' status.")
            
            if signals_df.empty:
                logging.warning("No completed or failed signals found in the database for ML training.")
                return pd.DataFrame()

            # Create the target variable 'success'
            # 1 if COMPLETED, 0 if FAILED
            signals_df['success'] = np.where(signals_df['tracking_status'] == 'COMPLETED', 1, 0)
            
            # --- Feature Engineering / Selection ---
            # Select numerical features that were available *at the time of the signal*
            features = [
                'score', 'signal_ratio', 
                'signal_volume', 'confirm_volume', 
                'signal_momentum_perc', 'confirm_momentum_perc',
                'signal_abs_price_change', 'confirm_abs_price_change',
                'volume_ok', 'momentum_perc_ok', 'momentum_abs_ok', 
                'is_confirmed_orig' 
                # Add more features if available and relevant
            ]
            
            # Ensure selected features exist
            available_features = [f for f in features if f in signals_df.columns]
            if not available_features:
                 logging.error("No suitable features found in the signals data for ML.")
                 return pd.DataFrame()
                 
            logging.info(f"Selected features for ML: {available_features}")

            ml_df = signals_df[available_features + ['success']].copy()

            # Basic Preprocessing within this function (can be moved to pipeline)
            # Handle potential infinities first
            ml_df.replace([np.inf, -np.inf], np.nan, inplace=True)
            
            # Simple imputation for NaNs (using median) - consider more sophisticated methods
            for col in available_features:
                if ml_df[col].isnull().any():
                    median_val = ml_df[col].median()
                    ml_df[col].fillna(median_val, inplace=True)
                    logging.debug(f"Imputed NaNs in '{col}' with median value {median_val}.")

            logging.info(f"Prepared DataFrame for ML with {len(ml_df)} samples and {len(available_features)} features.")
            return ml_df

        except pd.io.sql.DatabaseError as db_err:
            logging.error(f"Database error during ML data preparation: {db_err}")
            return pd.DataFrame()
        except Exception as e:
            logging.error(f"Error preparing ML data: {e}", exc_info=True)
            return pd.DataFrame()
        finally:
            if conn:
                conn.close()

    def train_and_evaluate_model(self):
        """Trains a simple ML model and evaluates it."""
        ml_data = self.prepare_ml_data()

        if ml_data.empty:
            logging.warning("ML Data preparation failed or returned empty data. Skipping training.")
            self.update_ml_results_display("Failed to prepare data for training.")
            return

        features = [col for col in ml_data.columns if col != 'success']
        X = ml_data[features]
        y = ml_data['success']

        if len(X) < 20: # Need sufficient data
            logging.warning(f"Insufficient data ({len(X)} samples) for ML training. Need at least 20.")
            self.update_ml_results_display(f"Insufficient data ({len(X)} samples) for training.")
            return
            
        # Check if target variable has both classes
        if len(y.unique()) < 2:
            logging.warning(f"Target variable 'success' has only one class ({y.unique()}). Cannot train classifier.")
            self.update_ml_results_display(f"Target variable 'success' has only one class ({y.unique()}). Training aborted.")
            return

        # Split data
        try:
             X_train, X_test, y_train, y_test = train_test_split(
                 X, y, test_size=0.3, random_state=42, stratify=y # Stratify for imbalanced classes
             )
        except ValueError as e:
             logging.error(f"Error during train_test_split (likely due to insufficient samples per class): {e}")
             self.update_ml_results_display(f"Error splitting data (insufficient samples per class?):\n{e}")
             return

        logging.info(f"Training data: {X_train.shape}, Testing data: {X_test.shape}")

        # Define Model Pipeline (Imputer + Scaler + Classifier)
        # Using RandomForest as it's less sensitive to feature scaling, but scaling is good practice
        self.ml_pipeline = Pipeline([
            ('imputer', SimpleImputer(strategy='median')), # Redundant if pre-imputed, but safe
            ('scaler', StandardScaler()), 
            ('classifier', RandomForestClassifier(n_estimators=100, random_state=42, class_weight='balanced')) # Handle imbalance
            # ('classifier', LogisticRegression(random_state=42, class_weight='balanced')) # Alternative
        ])

        try:
            # Train the model
            logging.info("Training ML model pipeline...")
            self.ml_pipeline.fit(X_train, y_train)
            logging.info("ML model training complete.")
            
            # Store the trained pipeline
            self.ml_model = self.ml_pipeline 
            
            # Evaluate the model
            logging.info("Evaluating ML model...")
            y_pred = self.ml_pipeline.predict(X_test)
            
            accuracy = accuracy_score(y_test, y_pred)
            report = classification_report(y_test, y_pred)
            matrix = confusion_matrix(y_test, y_pred)

            results_text = f"--- ML Model Evaluation ---\n"
            results_text += f"Model: {self.ml_pipeline.steps[-1][0]} ({type(self.ml_pipeline.steps[-1][1]).__name__})\n"
            results_text += f"Features: {features}\n"
            results_text += f"Training Samples: {len(X_train)}, Testing Samples: {len(X_test)}\n\n"
            results_text += f"Accuracy: {accuracy:.4f}\n\n"
            results_text += "Confusion Matrix:\n"
            results_text += f"{matrix}\n\n"
            results_text += "Classification Report:\n"
            results_text += f"{report}\n"
            
            # --- Feature Importance (Eklendi) ---
            if hasattr(self.ml_pipeline.steps[-1][1], 'feature_importances_'):
                importances = self.ml_pipeline.steps[-1][1].feature_importances_
                feature_names = X_train.columns # Özellik isimlerini alalım
                feature_importance_df = pd.DataFrame({'feature': feature_names, 'importance': importances})
                feature_importance_df = feature_importance_df.sort_values('importance', ascending=False)
                
                results_text += "\nFeature Importances:\n"
                results_text += feature_importance_df.to_string(index=False) + "\n"
                logging.info("Feature Importances calculated.")
            else:
                logging.warning("Could not retrieve feature importances from the model.")
            # --- /Feature Importance ---

            logging.info(f"Model Evaluation Results:\n{results_text}")
            
            # Display results in GUI
            self.update_ml_results_display(results_text)

        except Exception as e:
            logging.error(f"Error during ML model training or evaluation: {e}", exc_info=True)
            self.update_ml_results_display(f"Error during training/evaluation:\n{e}")
            self.ml_model = None # Ensure model is not stored if training failed
            
    def update_ml_results_display(self, text: str):
        """Updates the ML results text widget in the GUI."""
        # Ensure this runs in the main GUI thread
        def _update():
            if hasattr(self, 'ml_results_text_widget') and self.ml_results_text_widget.winfo_exists():
                self.ml_results_text_widget.config(state=tk.NORMAL) # Enable writing
                self.ml_results_text_widget.delete(1.0, tk.END) # Clear previous content
                self.ml_results_text_widget.insert(tk.END, text)
                self.ml_results_text_widget.config(state=tk.DISABLED) # Disable writing
            else:
                logging.warning("ML results text widget not available or destroyed.")
        
        if self.root and self.root.winfo_exists():
             self.root.after(0, _update)


