    def get_successful_trades(self, limit: int = 50) -> List[Dict[str, Any]]:
        """Veritabanından +%1 hedefine ulaşmış başarılı işlemleri çeker."""
        conn = self._connect_db()
        if conn is None: return []
        sql = ''' 
        SELECT 
            s.timestamp as signal_timestamp,
            s.symbol,
            s.signal_type,
            s.signal_price,
            s.score,
            s.ratio, 
            s.tracking_status, -- Renamed from status
            o.outcome_timestamp,
            o.achieved_price,
            o.time_to_target_s
        FROM outcomes o
        JOIN signals s ON o.signal_id = s.id
        WHERE s.tracking_status = 'COMPLETED' 
        ORDER BY o.outcome_timestamp DESC
        LIMIT ?
        '''
        trades = []
        try:
            cursor = conn.cursor()
            cursor.execute(sql, (limit,))
            rows = cursor.fetchall()
            for row in rows:
                trades.append(dict(row))
            logging.info(f"{len(trades)} adet başarılı işlem veritabanından çekildi (Limit: {limit}).")
            return trades
        except sqlite3.Error as e:
            logging.error(f"SQLite başarılı işlem çekme hatası: {e}")
            return []
        finally:
            if conn:
                conn.close()

    def run(self):
        """Programı başlat (WebSocket Entegrasyonu ile)"""
        logging.info("------ 'run' metodu başlatıldı. ------") # LOG EKLE
        # 1. Başlangıç zaman dilimini al
        initial_timeframe = self.selected_timeframe.get()
        # 2. Başlangıç verilerini yükle (ayrı thread'de)
        initial_load_thread = threading.Thread(target=self.update_initial_data, args=(initial_timeframe,), daemon=True)
        initial_load_thread.start()

        # 3. Başlangıç yüklemesinin bitmesini bekle
        logging.info("------ Başlangıç veri yüklemesi bekleniyor (initial_load_complete.wait())... ------") # LOG EKLE
        self.initial_load_complete.wait() # Event set edilene kadar bekler
        logging.info("------ Başlangıç veri yüklemesi tamamlandı (initial_load_complete.wait() geçildi). ------") # LOG EKLE
        # WebSocket başlatma artık update_initial_data içinde
        # logging.info("Başlangıç veri yüklemesi tamamlandı. WebSocket başlatılıyor...")
        # self._init_websocket()

        # 4. GUI'yi başlat (ana thread'de)
        logging.info("------ GUI başlatılıyor (root.mainloop())... ------") # LOG EKLE
        self.root.mainloop()

        # GUI kapandığında WebSocket'i de kapat (isteğe bağlı)
        if self.ws:
            logging.info("WebSocket kapatılıyor...")
            self.ws.close()
        logging.info("Program sonlandı.")

