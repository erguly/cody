# PineScript'in nz() fonksiyonunu taklit etmek için yardımcı fonksiyon
def nz(series, default=0.0):
    return series.fillna(default)

# PineScript'in ta.valuewhen() fonksiyonunu basitçe taklit (son değeri alır)
# Not: Gerçek ta.valuewhen daha karmaşıktır, occurrence parametresi vardır.
# Biz burada sadece son olayı alacağız.
def valuewhen(condition, source, occurrence=0):
    # condition True olduğunda source değerlerini al
    valid_source = source[condition]
    # Eğer hiç True yoksa veya occurrence index dışındaysa NaN döndür
    if valid_source.empty or abs(occurrence) >= len(valid_source):
        return np.nan
    # İstenen olayı döndür (0 son olay, 1 bir önceki vb.)
    return valid_source.iloc[-1 - occurrence]

