    def _connect_db(self):
        """Veritabanına bağlantı oluşturur."""
        conn = None
        try:
            conn = sqlite3.connect(self.db_file)
            conn.row_factory = sqlite3.Row # Satırları dict gibi kullanmak için
            return conn
        except sqlite3.Error as e:
            logging.error(f"SQLite bağlantı hatası: {e}")
        return conn

    def _init_db(self):
        """Veritabanı tablolarını oluşturur (varsa es geçer)."""
        conn = self._connect_db()
        if conn is None:
            return
        try:
            cursor = conn.cursor()
            
            # --- Eski 'status' sütununu 'tracking_status' olarak yeniden adlandırma (Mevcut DB için) ---
            cursor.execute("PRAGMA table_info(signals)")
            columns = [column[1] for column in cursor.fetchall()]
            if 'status' in columns and 'tracking_status' not in columns:
                logging.info("Eski 'status' sütunu bulundu, 'tracking_status' olarak yeniden adlandırılıyor...")
                try:
                    # Önce indeksleri kontrol et ve varsa sil (SQLite < 3.25 için gerekli olabilir)
                    # cursor.execute("DROP INDEX IF EXISTS idx_signals_status") 
                    cursor.execute("ALTER TABLE signals RENAME COLUMN status TO tracking_status")
                    conn.commit()
                    logging.info("'status' sütunu başarıyla 'tracking_status' olarak yeniden adlandırıldı.")
                except sqlite3.Error as rename_error:
                    logging.error(f"'status' sütununu yeniden adlandırırken SQLite hatası: {rename_error}")
                    # Hata olursa devam etmeyi dene, belki tablo zaten doğru formattadır
            # -------------------------------------------------------------------------------------
            
            # Sinyal tablosu (Genişletilmiş Sütunlarla)
            cursor.execute("""
            CREATE TABLE IF NOT EXISTS signals (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                timestamp TEXT NOT NULL,            -- Sinyal onay zamanı
                symbol TEXT NOT NULL,
                signal_type TEXT NOT NULL,        -- C10L / C20L
                score REAL,                       -- Sinyal anındaki skor
                ratio REAL,                       -- Sinyal anındaki ratio (diff_percent)
                signal_price REAL,                -- Teyit mumu kapanış fiyatı
                signal_volume INTEGER,            -- Sinyal mumu (-2) hacmi
                confirm_volume INTEGER,           -- Teyit mumu (-1) hacmi
                signal_momentum_perc REAL,        -- Sinyal mumu % momentumu
                confirm_momentum_perc REAL,       -- Teyit mumu % momentumu
                signal_abs_price_change REAL,     -- Sinyal mumu mutlak fiyat değişimi
                confirm_abs_price_change REAL,    -- Teyit mumu mutlak fiyat değişimi
                volume_ok INTEGER,                -- confirm_volume >= signal_volume (0/1)
                momentum_perc_ok INTEGER,         -- confirm_momentum_perc >= signal_momentum_perc (0/1)
                momentum_abs_ok INTEGER,          -- confirm_abs_price_change >= signal_abs_price_change (0/1)
                is_confirmed_orig INTEGER,        -- volume_ok AND momentum_perc_ok (0/1)
                tracking_status TEXT DEFAULT 'TRACKING' -- TRACKING / COMPLETED / FAILED (isteğe bağlı)
            )
            """)
            # Sonuç tablosu
            cursor.execute("""
            CREATE TABLE IF NOT EXISTS outcomes (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                signal_id INTEGER NOT NULL,
                outcome_timestamp TEXT NOT NULL,
                achieved_price REAL,
                time_to_target_s REAL,
                FOREIGN KEY (signal_id) REFERENCES signals (id)
            )
            """)
            conn.commit()
            logging.info(f"Veritabanı '{self.db_file}' başarıyla başlatıldı/kontrol edildi.")
        except sqlite3.Error as e:
            logging.error(f"SQLite tablo oluşturma hatası: {e}")
        finally:
            if conn:
                conn.close()

    def log_signal_to_db(self, symbol: str, signal_type: str, timestamp: datetime, details: dict) -> int | None:
        """Onaylanmış sinyali genişletilmiş detaylarla veritabanına yazar ve ID'sini döndürür."""
        # --- Timestamp Kontrolü Eklendi ---
        if timestamp is None or not isinstance(timestamp, datetime):
            logging.error(f"[{symbol}] log_signal_to_db fonksiyonuna geçersiz timestamp değeri geldi! Tip: {type(timestamp)}, Değer: {timestamp}")
            return None
        # ---------------------------------
        conn = self._connect_db()
        if conn is None: return None
        # Sütun isimlerini açıkça belirtmek daha güvenli
        sql = ''' INSERT INTO signals(
                    timestamp, symbol, signal_type, score, ratio, signal_price, 
                    signal_volume, confirm_volume, 
                    signal_momentum_perc, confirm_momentum_perc, 
                    signal_abs_price_change, confirm_abs_price_change,
                    volume_ok, momentum_perc_ok, momentum_abs_ok, is_confirmed_orig,
                    tracking_status
                ) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?) '''
        try:
            cursor = conn.cursor()
            conf = details.get('confirmation', {}) # Kısaltma
            cursor.execute(sql, (
                timestamp.strftime("%Y-%m-%d %H:%M:%S"),
                symbol,
                signal_type,
                self.scores.get(symbol, 0.0),
                details.get('diff_percent', 0.0), # Ratio
                details.get('signal_price', 0.0), # Teyit mumu kapanış fiyatı
                conf.get('signal_volume', 0),
                conf.get('confirm_volume', 0),
                conf.get('signal_momentum', 0.0), # Yüzdesel momentum
                conf.get('confirm_momentum', 0.0),
                conf.get('signal_abs_price_change', 0.0), # Mutlak değişim
                conf.get('confirm_abs_price_change', 0.0),
                1 if conf.get('volume_ok', False) else 0, # Boolean to Int
                1 if conf.get('momentum_ok', False) else 0, # Yüzdesel momentum onayı
                1 if conf.get('abs_momentum_ok', False) else 0, # Mutlak momentum onayı
                1 if conf.get('confirmed', False) else 0, # Orijinal teyit (Vol & %Mom)
                'TRACKING'
            ))
            conn.commit()
            signal_id = cursor.lastrowid 
            logging.debug(f"Sinyal veritabanına eklendi (ID: {signal_id}): {symbol} {signal_type}")
            return signal_id
        except sqlite3.Error as e:
            logging.error(f"SQLite sinyal ekleme hatası: {e}")
            return None
        finally:
            if conn:
                conn.close()

