    def _get_symbols(self) -> List[str]:
        """Binance'den USDT paritelerini al (Stabilcoinler ve PAXG hariç)"""
        excluded_suffixes = ['USDC', 'BUSD', 'TUSD', 'DAI', 'USDP', 'FDUSD'] # Hariç tutulacak stabilcoinlerin temel isimleri
        excluded_symbols = ['PAXGUSDT'] # Direkt hariç tutulacak semboller
        target_suffix = 'USDT'
        fetch_limit = 300 # Başlangıçta çekilecek parite sayısı (artırıldı)
        final_limit = 200 # Sonuçta kullanılacak parite sayısı (artırıldı)

        try:
            exchange_info = self.client.get_exchange_info()
            all_symbols = []
            for s in exchange_info['symbols']:
                # Sadece USDT ile biten ve durumu TRADING olanları al
                if s['symbol'].endswith(target_suffix) and s['status'] == 'TRADING':
                    all_symbols.append(s['symbol'])
            
            # Sembolleri sırala (isteğe bağlı, genellikle borsa sırası yeterli)
            # all_symbols.sort()
            
            # İlk `fetch_limit` kadarını al
            initial_list = all_symbols[:fetch_limit]
            
            # Filtreleme
            filtered_symbols = []
            for symbol in initial_list:
                # Direkt hariç tutulanlarda var mı?
                if symbol in excluded_symbols:
                    continue
                
                # Stabilcoin paritesi mi kontrol et (örn. TUSDUSDT)
                is_excluded_stablecoin = False
                for suffix in excluded_suffixes:
                    # Eğer sembol USDT ile bitiyorsa ve başı stabilcoin adıysa
                    if symbol.startswith(suffix) and symbol.endswith(target_suffix):
                        is_excluded_stablecoin = True
                        break # Başka kontrol etmeye gerek yok
                
                if is_excluded_stablecoin:
                    continue
                    
                # Tüm kontrollerden geçtiyse listeye ekle
                filtered_symbols.append(symbol)

            # Son limiti uygula
            final_symbols = filtered_symbols[:final_limit]
            logging.info(f"{len(final_symbols)} adet filtrelenmiş sembol yüklendi.")
            return final_symbols
            
        except BinanceAPIException as e:
            logging.error(f"Semboller alınırken hata: {e}")
            return []

    def get_klines(self, symbol: str, limit: int = 200, timeframe_override: str = None) -> pd.DataFrame:
        """Belirli bir sembol için kline verilerini REST API ile al"""
        selected_tf = timeframe_override if timeframe_override else self.selected_timeframe.get() # Seçili zaman dilimini al
        try:
            klines = self.client.get_klines(symbol=symbol, interval=selected_tf, limit=limit)
            df = pd.DataFrame(klines, columns=['timestamp', 'open', 'high', 'low', 'close', 'volume', 
                                            'close_time', 'quote_asset_volume', 'number_of_trades',
                                            'taker_buy_base_asset_volume', 'taker_buy_quote_asset_volume', 'ignore'])
            df['timestamp'] = pd.to_datetime(df['timestamp'], unit='ms')
            for col in ['open', 'high', 'low', 'close', 'volume']:
                df[col] = df[col].astype(float)
            df.set_index('timestamp', inplace=True) # Zamanı index yapalım
            return df
        except BinanceAPIException as e:
            logging.error(f"{symbol} ({selected_tf}) için kline verisi alınırken hata: {e}")
            return pd.DataFrame()

    def calculate_rsi(self, df: pd.DataFrame) -> Tuple[float, float, float]:
        """RSI hesaplama"""
        # RSI hesaplamaları için pandas Series kullan
        rsi_high = ta.momentum.RSIIndicator(pd.Series(df['high']), window=self.period).rsi()
        rsi_low = ta.momentum.RSIIndicator(pd.Series(df['low']), window=self.period).rsi()
        rsi_close = ta.momentum.RSIIndicator(pd.Series(df['close']), window=self.period).rsi()
        
        # Son değerleri al ve float'a çevir
        rsi_high_value = float(rsi_high.iloc[-1]) if not pd.isna(rsi_high.iloc[-1]) else 0.0
        rsi_low_value = float(rsi_low.iloc[-1]) if not pd.isna(rsi_low.iloc[-1]) else 0.0
        rsi_close_value = float(rsi_close.iloc[-1]) if not pd.isna(rsi_close.iloc[-1]) else 0.0
        
        return rsi_high_value, rsi_low_value, rsi_close_value

    def calculate_zscore(self, df: pd.DataFrame) -> float:
        """Z-Score hesaplama"""
        if len(df) < self.z_score_length:
            return 0.0
        ma = df['close'].rolling(window=self.z_score_length).mean()
        std = df['close'].rolling(window=self.z_score_length).std()
        zscore = (df['close'].iloc[-1] - ma.iloc[-1]) / std.iloc[-1] if std.iloc[-1] != 0 else 0
        return zscore if pd.notna(zscore) else 0.0

    def calculate_ratios(self, df: pd.DataFrame) -> Dict[str, float]:
        """Çeşitli finansal oranları hesapla (Adapt edilmiş yeni mantık)"""
        func_name = "calculate_ratios"
        symbol = df.name if hasattr(df, 'name') else "Unknown"
        min_len_required = max(self.period, self.z_score_length) + 1

        # Başlangıç değerleri ile sözlük oluştur
        results = {
            'sharpe': 0.0, 'sortino': 0.0, 'calmar': 0.0, 'omega': 0.0,
            'price_change': 0.0, 'score_raw': 0.0
        }

        if len(df) < min_len_required:
            return results

        try:
            data = df['close'] # Artık Series
            
            # Logaritmik Getirileri Hesapla (vektörel)
            close_shifted = data.shift(1)
            valid_mask = (data > 0) & (close_shifted > 0)
            returns = pd.Series(np.nan, index=data.index)
            returns[valid_mask] = np.log(data[valid_mask] / close_shifted[valid_mask])
            returns = returns.dropna()

            if len(returns) < max(self.period, self.z_score_length):
                return results # Yeterli getiri yoksa çık

            # --- Hesaplamalar --- 
            last_zscore = 0.0
            last_sharpe = 0.0
            last_sortino = 0.0
            last_calmar = 0.0
            last_omega = 0.0
            last_weighted_score = 0.0
            
            # Z-Score (Her zaman hesapla, Series döndürür)
            if len(data) >= self.z_score_length:
                zscore_series = (
                    (data - data.rolling(window=self.z_score_length).mean()) 
                    / data.rolling(window=self.z_score_length).std()
                ).fillna(0) # NaN yerine 0
                if not zscore_series.empty and pd.notna(zscore_series.iloc[-1]):
                    last_zscore = zscore_series.iloc[-1]

            # Finansal Oranlar (use_zscore False ise)
            if not self.use_zscore and len(returns) >= self.period:
                avg_return_series = returns.rolling(window=self.period).mean()
                std_return_series = returns.rolling(window=self.period).std(ddof=1)
                
                if not avg_return_series.empty and not std_return_series.empty and pd.notna(avg_return_series.iloc[-1]):
                    avg_return = avg_return_series.iloc[-1]
                    last_std = std_return_series.iloc[-1] if pd.notna(std_return_series.iloc[-1]) else 0.0
                    
                    # Sharpe
                    last_sharpe = (avg_return - self.rff) / last_std if last_std != 0 else 0.0
                    
                    # Sortino
                    neg_returns = returns[returns < 0]
                    sortino = 0.0
                    if not neg_returns.empty:
                        neg_std_series = neg_returns.rolling(window=self.period).std(ddof=1)
                        if not neg_std_series.empty and pd.notna(neg_std_series.iloc[-1]):
                            last_neg_std = neg_std_series.iloc[-1]
                            sortino = (avg_return - self.rff) / last_neg_std if last_neg_std != 0 else 0.0
                    last_sortino = sortino
                    
                    # Calmar
                    calmar = 0.0
                    rolling_close = data.rolling(window=self.period)
                    high_in_period = rolling_close.max()
                    low_in_period = rolling_close.min()
                    if not high_in_period.empty and not low_in_period.empty and pd.notna(high_in_period.iloc[-1]) and pd.notna(low_in_period.iloc[-1]):
                        price_range = high_in_period.iloc[-1] - low_in_period.iloc[-1]
                        calmar = avg_return / price_range if price_range != 0 else 0.0
                    last_calmar = calmar
                    
                    # Omega
                    omega = 0.0
                    threshold = self.rff
                    gains = returns[returns >= threshold] - threshold
                    losses = threshold - returns[returns < threshold]
                    if not gains.empty and not losses.empty:
                        sum_gains_series = gains.rolling(window=self.period).sum()
                        sum_losses_series = losses.rolling(window=self.period).sum()
                        if not sum_gains_series.empty and not sum_losses_series.empty and pd.notna(sum_gains_series.iloc[-1]) and pd.notna(sum_losses_series.iloc[-1]):
                            sum_gains = sum_gains_series.iloc[-1]
                            sum_losses = sum_losses_series.iloc[-1]
                            omega = sum_gains / sum_losses if sum_losses != 0 else 0.0 
                    last_omega = omega
                    
                    # Ağırlıklı Skor
                    last_weighted_score = (
                        (last_sortino * 0.40 if pd.notna(last_sortino) else 0.0) + 
                        (last_omega * 0.30 if pd.notna(last_omega) and np.isfinite(last_omega) else 0.0) + 
                        (last_calmar * 0.20 if pd.notna(last_calmar) else 0.0) + 
                        (last_sharpe * 0.10 if pd.notna(last_sharpe) else 0.0)
                    )
            
            # Sonuçları güncelle
            results['sharpe'] = last_sharpe if pd.notna(last_sharpe) else 0.0
            results['sortino'] = last_sortino if pd.notna(last_sortino) else 0.0
            results['calmar'] = last_calmar if pd.notna(last_calmar) else 0.0
            results['omega'] = last_omega if pd.notna(last_omega) and np.isfinite(last_omega) else 0.0
            
            # Ham skoru ata (Z-Score veya ağırlıklı skor)
            results['score_raw'] = last_zscore if self.use_zscore else last_weighted_score
            results['score_raw'] = results['score_raw'] if pd.notna(results['score_raw']) else 0.0
            
            # Basit fiyat değişimi
            price_change = 0.0
            if len(data) > 1 and pd.notna(data.iloc[-1]) and pd.notna(data.iloc[-2]) and data.iloc[-2] != 0:
                price_change = ((data.iloc[-1] - data.iloc[-2]) / data.iloc[-2]) * 100
            results['price_change'] = price_change if pd.notna(price_change) else 0.0
            
            return results

        except IndexError as e:
             logging.error(f"{symbol} - {func_name}: IndexError - {e}. Veri Uzunluğu: {len(df)}, Getiri Uzunluğu: {len(returns) if 'returns' in locals() else 'N/A'}")
             return results # Başlangıç değerlerini döndür
        except Exception as e:
            logging.error(f"{symbol} - {func_name}: Beklenmedik Hata - {e}", exc_info=True)
            return results # Başlangıç değerlerini döndür

    def calculate_signals(self, df: pd.DataFrame) -> Dict[str, Any]:
        """Alım-satım sinyallerini ve PineScript uyumlu pullback farkını hesapla"""
        func_name = "calculate_signals"
        symbol = df.name if hasattr(df, 'name') else "Unknown"
        atr_period = 10
        multiplier = 3.0
        min_len = atr_period + 1 
        if len(df) < min_len:
             return {
                'long_signal': False, 'short_signal': False, 'c20l_signal': False, 'c10l_signal': False,
                'confirmation': {}, 'diff_percent': 0.0, 'signal_price': 0.0
            }
            
        try:
            src = df['close']
            H_lvl = df['high']
            L_lvl = df['low']
            
            # ATR 
            atr_indicator = ta.volatility.AverageTrueRange(
                high=H_lvl, low=L_lvl, close=src, window=atr_period, fillna=False
            )
            atr = atr_indicator.average_true_range()
            first_valid_index = atr.first_valid_index()
            if first_valid_index is None:
                return {
                    'long_signal': False, 'short_signal': False, 'c20l_signal': False, 'c10l_signal': False,
                    'confirmation': {}, 'diff_percent': 0.0, 'signal_price': 0.0
                }
            
            # İlk geçerli index'in integer konumunu bul
            try:
                first_valid_iloc = df.index.get_loc(first_valid_index)
            except KeyError:
                 logging.error(f"{symbol} - {func_name}: İlk geçerli ATR indeksi ({first_valid_index}) DataFrame indeksinde bulunamadı.")
                 return { # Hata durumunda boş dön
                    'long_signal': False, 'short_signal': False, 'c20l_signal': False, 'c10l_signal': False,
                    'confirmation': {}, 'diff_percent': 0.0, 'signal_price': 0.0
                 } 

            # Supertrend Bantları (Pine'daki gibi)
            pine_up_band_basic = (H_lvl + L_lvl) / 2 - multiplier * atr
            pine_dn_band_basic = src + multiplier * atr 
            pine_final_up = pd.Series(np.nan, index=df.index) 
            pine_final_low = pd.Series(np.nan, index=df.index) 
            trend = pd.Series(np.nan, index=df.index)
            buy_signal = pd.Series(False, index=df.index)
            sell_signal = pd.Series(False, index=df.index)
            
            # --- PineScript diff_percent Hesaplaması İçin Gerekli Seriler ---
            diff_percent_series = pd.Series(np.nan, index=df.index) # Başlangıçta NaN
            longPullbackLevel2 = pd.Series(np.nan, index=df.index) # Pine: var float longPullbackLevel2 = na
            # shortPullbackLevel2 Pine'da var ama diff_percent için kullanılmıyor, sadece long'u set etmek için.
            isAfterShort = pd.Series(False, index=df.index)     # Pine: var bool isAfterShort = false
            # ----------------------------------------------------

            # İlk değerler (artık iloc ile)
            pine_final_up.iloc[first_valid_iloc] = pine_dn_band_basic.iloc[first_valid_iloc]
            pine_final_low.iloc[first_valid_iloc] = pine_up_band_basic.iloc[first_valid_iloc]
            trend.iloc[first_valid_iloc] = 1.0 

            # Döngü (artık iloc ile)
            for i in range(first_valid_iloc + 1, len(df)):
                # Önceki değerleri taşı (Pullback seviyeleri ve flag için)
                longPullbackLevel2.iloc[i] = longPullbackLevel2.iloc[i-1]
                isAfterShort.iloc[i] = isAfterShort.iloc[i-1]

                # --- Supertrend Hesaplamaları (öncekiyle aynı) --- 
                prev_final_up = pine_final_up.iloc[i-1]
                prev_final_low = pine_final_low.iloc[i-1]
                prev_trend = trend.iloc[i-1]
                prev_close = src.iloc[i-1]
                current_close = src.iloc[i]
                current_pine_up_basic = pine_up_band_basic.iloc[i]
                current_pine_dn_basic = pine_dn_band_basic.iloc[i]
                current_low = L_lvl.iloc[i]
                current_high = H_lvl.iloc[i]
                
                # NaN kontrolü 
                if pd.isna(prev_final_up) or pd.isna(prev_final_low) or pd.isna(prev_trend) or pd.isna(prev_close) or pd.isna(current_close) or pd.isna(current_pine_up_basic) or pd.isna(current_pine_dn_basic):
                    pine_final_up.iloc[i] = prev_final_up
                    pine_final_low.iloc[i] = prev_final_low
                    trend.iloc[i] = prev_trend
                    buy_signal.iloc[i] = False
                    sell_signal.iloc[i] = False
                    diff_percent_series.iloc[i] = diff_percent_series.iloc[i-1]
                    continue
                
                # Final Bantları
                if prev_close < prev_final_up:
                    pine_final_up.iloc[i] = min(current_pine_dn_basic, prev_final_up)
                else:
                    pine_final_up.iloc[i] = current_pine_dn_basic
                if prev_close > prev_final_low:
                    pine_final_low.iloc[i] = max(current_pine_up_basic, prev_final_low)
                else:
                    pine_final_low.iloc[i] = current_pine_up_basic
                
                # Trend
                current_trend = prev_trend 
                if prev_trend == -1.0 and current_close > prev_final_up:
                    current_trend = 1.0
                elif prev_trend == 1.0 and current_close < prev_final_low:
                    current_trend = -1.0
                trend.iloc[i] = current_trend
                
                # Sinyaller
                buy_signal.iloc[i] = (trend.iloc[i] == 1.0) and (prev_trend == -1.0)
                sell_signal.iloc[i] = (trend.iloc[i] == -1.0) and (prev_trend == 1.0)
                # ---------------------------------------------------

                # --- PineScript Pullback Seviyesi Güncelleme Mantığı --- 
                # if short_signal:
                #    shortPullbackLevel2 := H_lvl
                #    longPullbackLevel2 := shortPullbackLevel2 
                #    isAfterShort := true
                if sell_signal.iloc[i] and pd.notna(current_high):
                    shortPullbackLevel_current = current_high # Bunu sadece long'u set etmek için kullanıyoruz
                    longPullbackLevel2.iloc[i] = shortPullbackLevel_current # Pine'daki gibi long'u short'un high'ına set et
                    isAfterShort.iloc[i] = True

                # if long_signal and na(longPullbackLevel2):
                #    longPullbackLevel2 := L_lvl
                #    isAfterShort := false
                if buy_signal.iloc[i] and pd.isna(longPullbackLevel2.iloc[i-1]) and pd.notna(current_low):
                     longPullbackLevel2.iloc[i] = current_low
                     # isAfterShort zaten False olmalı ilk L sinyalinde

                # if long_signal and isAfterShort:
                #    longPullbackLevel2 := L_lvl
                #    isAfterShort := false
                if buy_signal.iloc[i] and isAfterShort.iloc[i-1] and pd.notna(current_low):
                    longPullbackLevel2.iloc[i] = current_low
                    isAfterShort.iloc[i] = False
                # ---------------------------------------------------------

                # --- PineScript diff_percent Hesaplaması ---
                # diff_percent = na(longPullbackLevel2) ? na : ((src - longPullbackLevel2) / longPullbackLevel2) * 100
                current_pullback_level = longPullbackLevel2.iloc[i] # Sadece long seviyesini kullan
                current_diff = np.nan # Varsayılan NaN
                if pd.notna(current_pullback_level) and current_pullback_level != 0 and pd.notna(current_close):
                    current_diff = ((current_close - current_pullback_level) / current_pullback_level) * 100
                diff_percent_series.iloc[i] = current_diff
                # -----------------------------------------
            
            # --- Hesaplama Sonu --- 
            signal_price = df['close'].iloc[-1] if not df.empty else 0.0 
            
            # Son fark değeri
            last_diff_percent = diff_percent_series.iloc[-1] if not diff_percent_series.empty else np.nan

            # RSI Sinyalleri (PineScript crossover mantığı ile)
            c10l_signal = False
            c20l_signal = False
            # En az 3 RSI değeri gerekli (son 2 değişimi hesaplamak için)
            min_rsi_len = self.period + 2 
            if len(df) > min_rsi_len:
                try:
                    rsi_indicator = ta.momentum.RSIIndicator(df['close'].dropna(), window=self.period).rsi()
                    # En az 3 geçerli RSI değeri var mı kontrol et
                    if not rsi_indicator.empty and len(rsi_indicator.dropna()) >= 3:
                        # Son 3 RSI değerini al
                        rsi_now = rsi_indicator.iloc[-1]
                        rsi_prev = rsi_indicator.iloc[-2]
                        rsi_prev2 = rsi_indicator.iloc[-3]
                        
                        # NaN kontrolü
                        if pd.notna(rsi_now) and pd.notna(rsi_prev) and pd.notna(rsi_prev2):
                            rsi_change_current = rsi_now - rsi_prev
                            rsi_change_previous = rsi_prev - rsi_prev2
                            
                            # Crossover kontrolleri
                            c10l_signal = (rsi_change_previous <= 10) and (rsi_change_current > 10)
                            c20l_signal = (rsi_change_previous <= 20) and (rsi_change_current > 20)
                            
                except Exception as e:
                    logging.error(f"{symbol} - {func_name}: RSI Hesaplama Hatası - {e}")
            
            # Teyit Kontrolü
            confirmation = self.check_confirmation(df)
            
            # Son Sinyaller
            last_long_signal = buy_signal.iloc[-1] if not buy_signal.empty and pd.notna(buy_signal.iloc[-1]) else False
            last_short_signal = sell_signal.iloc[-1] if not sell_signal.empty and pd.notna(sell_signal.iloc[-1]) else False
            
            return {
                'long_signal': last_long_signal, 
                'short_signal': last_short_signal, 
                'c20l_signal': c20l_signal,
                'c10l_signal': c10l_signal,
                'confirmation': confirmation,
                'diff_percent': last_diff_percent if pd.notna(last_diff_percent) else 0.0, # NaN ise 0 döndür
                'signal_price': signal_price if pd.notna(signal_price) else 0.0
            }

        except IndexError as e:
             logging.error(f"{symbol} - {func_name}: IndexError - {e}. Veri Uzunluğu: {len(df)}")
             return {'long_signal': False, 'short_signal': False, 'c20l_signal': False, 'c10l_signal': False, 'confirmation': {}, 'diff_percent': 0.0, 'signal_price': 0.0}
        except Exception as e:
            logging.error(f"{symbol} - {func_name}: Beklenmedik Hata - {e}", exc_info=True)
            return {'long_signal': False, 'short_signal': False, 'c20l_signal': False, 'c10l_signal': False, 'confirmation': {}, 'diff_percent': 0.0, 'signal_price': 0.0}

    def check_confirmation(self, df: pd.DataFrame) -> Dict[str, Any]:
        """Sinyal teyidini kontrol et (Yüzdesel Değişim Odaklı)"""
        func_name = "check_confirmation"
        symbol = df.name if hasattr(df, 'name') else "Unknown"

        # Başlangıç değerleri (yeni flag'ler eklendi)
        default_result = {
            'confirmed': False, 
            'volume_ok': False, 'momentum_ok': False, 'abs_momentum_ok': False,
            'volume_perc_change_ok': False, # Yeni flag
            'confirm_momentum_positive': False, # Yeni flag
            'signal_volume': 0, 'confirm_volume': 0,
            'signal_momentum': 0.0, 'confirm_momentum': 0.0,
            'signal_abs_price_change': 0.0, 'confirm_abs_price_change': 0.0,
            'volume_change_perc': 0.0 # Hesaplanan yüzdesel değişim
        }

        if len(df) < 3: # En az 3 mum gerekli
            return default_result

        try:
            # Mumları ve değerleri al
            pre_signal_candle = df.iloc[-3]
            signal_candle = df.iloc[-2]
            confirm_candle = df.iloc[-1]

            # Değerlerin geçerliliğini kontrol et
            required_cols = ['close', 'volume']
            if any(pd.isna(pre_signal_candle[col]) for col in required_cols) or \
               any(pd.isna(signal_candle[col]) for col in required_cols) or \
               any(pd.isna(confirm_candle[col]) for col in required_cols):
                return default_result

            # --- Hacim Hesaplamaları ---
            signal_volume = signal_candle['volume']
            confirm_volume = confirm_candle['volume']
            volume_ok_orig = confirm_volume >= signal_volume # Orijinal mutlak kontrol (loglama için)
            
            # Yeni: Hacim Yüzdesel Değişim Kontrolü
            volume_change_perc = 0.0
            if signal_volume > 0: # Sıfıra bölme hatasını önle
                volume_change_perc = ((confirm_volume - signal_volume) / signal_volume) * 100
            volume_perc_change_ok = volume_change_perc > self.VOLUME_CHANGE_PERC_THRESHOLD

            # --- Momentum Hesaplamaları ---
            signal_momentum_perc = 0.0
            if pre_signal_candle['close'] != 0:
                signal_momentum_perc = ((signal_candle['close'] - pre_signal_candle['close']) / pre_signal_candle['close']) * 100
            confirm_momentum_perc = 0.0
            if signal_candle['close'] != 0:
                 confirm_momentum_perc = ((confirm_candle['close'] - signal_candle['close']) / signal_candle['close']) * 100
            momentum_perc_ok_orig = confirm_momentum_perc >= signal_momentum_perc # Orijinal karşılaştırma (loglama için)

            # Yeni: Teyit Mumu Momentum Kontrolü
            confirm_momentum_positive = confirm_momentum_perc > self.CONFIRM_MOMENTUM_PERC_THRESHOLD

            # --- Mutlak Fiyat Değişimi (Abs Momentum) ---
            signal_abs_price_change = signal_candle['close'] - pre_signal_candle['close']
            confirm_abs_price_change = confirm_candle['close'] - signal_candle['close']
            momentum_abs_ok = confirm_abs_price_change >= signal_abs_price_change # Bu aynı kalabilir

            # --- Yeni Ana Teyit Mantığı ---
            confirmed = volume_perc_change_ok and confirm_momentum_positive

            return {
                'confirmed': confirmed, # Ana teyit artık yeni mantığa göre
                'volume_ok': volume_ok_orig, # Orijinal kontrolü bilgi için sakla
                'momentum_ok': momentum_perc_ok_orig, # Orijinal kontrolü bilgi için sakla
                'abs_momentum_ok': momentum_abs_ok, 
                'volume_perc_change_ok': volume_perc_change_ok, # Yeni kontrol sonucu
                'confirm_momentum_positive': confirm_momentum_positive, # Yeni kontrol sonucu
                'signal_volume': signal_volume if pd.notna(signal_volume) else 0,
                'confirm_volume': confirm_volume if pd.notna(confirm_volume) else 0,
                'signal_momentum': signal_momentum_perc if pd.notna(signal_momentum_perc) else 0.0,
                'confirm_momentum': confirm_momentum_perc if pd.notna(confirm_momentum_perc) else 0.0,
                'signal_abs_price_change': signal_abs_price_change if pd.notna(signal_abs_price_change) else 0.0,
                'confirm_abs_price_change': confirm_abs_price_change if pd.notna(confirm_abs_price_change) else 0.0,
                'volume_change_perc': volume_change_perc if pd.notna(volume_change_perc) else 0.0 # Hesaplanan % hacim değişimi
            }

        except IndexError:
            return default_result
        except Exception as e:
            logging.error(f"{symbol} - {func_name}: Beklenmedik Hata - {e}", exc_info=True)
            return default_result

    def sort_symbols(self):
        """Sembolleri sırala"""
        # Score ve ratio sıralamaları için listeler oluştur
        score_ranks = {}
        ratio_ranks = {}
        
        # Score sıralaması
        sorted_by_score = sorted(self.scores.items(), key=lambda x: x[1], reverse=True)
        for rank, (symbol, _) in enumerate(sorted_by_score):
            score_ranks[symbol] = rank
        
        # Ratio sıralaması
        sorted_by_ratio = sorted(self.ratios.items(), key=lambda item: item[1].get('price_change', 0.0), reverse=True)
        for rank, (symbol, _) in enumerate(sorted_by_ratio):
            ratio_ranks[symbol] = rank
        
        # Eşleşen rankları bul
        matched_symbols = []
        for symbol in self.symbols:
            if symbol in score_ranks and symbol in ratio_ranks:
                if score_ranks[symbol] == ratio_ranks[symbol]:
                    matched_symbols.append(symbol)
        
        return matched_symbols, score_ranks, ratio_ranks

    def update_initial_data(self, timeframe_to_load: str):
        """Belirli bir zaman dilimi için BAŞLANGIÇ verilerini REST API ile yükle."""
        # current_tf = self.selected_timeframe.get() # -> Hata veriyordu
        logging.info(f"[{timeframe_to_load}] update_initial_data başladı...") # LOG EKLE
        symbols_loaded = 0
        required_data_length = max(self.period, self.z_score_length) + 2

        symbol_index = 0 # Loglama için sayaç
        total_symbols = len(self.symbols)
        for symbol in self.symbols:
            symbol_index += 1
            logging.debug(f"[{timeframe_to_load}] Başlangıç verisi yükleniyor: {symbol} ({symbol_index}/{total_symbols})") # LOG EKLE (Debug)
            # Zaman dilimi yükleme BAŞLADIKTAN SONRA değişti mi diye kontrol et
            # Yüklenmesi istenen TF ile bu thread'in başladığı TF farklı mı?
            if self.currently_requested_timeframe != timeframe_to_load:
                logging.warning(f"Başlangıç yüklemesi ({timeframe_to_load}) sırasında zaman dilimi ({self.currently_requested_timeframe}) değişti, yükleme iptal ediliyor.")
                # GUI elemanını tekrar aktif et (hata durumu)
                self.root.after(0, lambda: self.timeframe_combobox.config(state="readonly"))
                return # Bu thread'i sonlandır

            try:
                # get_klines timeframe_to_load'ı kullanacak
                df_initial = self.get_klines(symbol, limit=300, timeframe_override=timeframe_to_load)
                if not df_initial.empty and len(df_initial) >= required_data_length:
                    self.data[symbol] = df_initial
                    # Başlangıç hesaplamaları
                    self._recalculate_symbol(symbol, is_closed=True, is_initial_load=True)
                    symbols_loaded += 1
                    # logging.debug(f"{symbol} ({timeframe_to_load}) için başlangıç verisi yüklendi ve hesaplandı.") # Moved debug log
                else:
                    logging.warning(f"{symbol} ({timeframe_to_load}) için yeterli başlangıç verisi alınamadı veya yüklenemedi (Alınan: {len(df_initial)}).")
            except Exception as e:
                logging.error(f"{symbol} ({timeframe_to_load}) için başlangıç verisi yüklenirken hata: {e}", exc_info=False)

            # === YENİ EKLENEN SATIR ===
            time.sleep(0.1) # API çağrıları arasına küçük bir gecikme ekle
            # ==========================

        # Yükleme bittikten sonra hala bu timeframe mi isteniyor?
        if self.currently_requested_timeframe == timeframe_to_load:
            logging.info(f"[{timeframe_to_load}] Başlangıç veri yükleme döngüsü tamamlandı. {symbols_loaded}/{len(self.symbols)} sembol başarıyla yüklendi.") # LOG EKLE
            logging.info(f"[{timeframe_to_load}] initial_load_complete.set() çağrılıyor.") # LOG EKLE
            self.initial_load_complete.set() # Yüklemenin bittiğini işaretle

            # Başlangıç GUI güncellemesi
            self.root.after(0, self.filter_symbols)

            # WebSocket'i başlat
            self.root.after(0, self._init_websocket)

            # GUI elemanını aktif et
            self.root.after(0, lambda: self.timeframe_combobox.config(state="readonly"))
        else:
            logging.info(f"{timeframe_to_load} için başlangıç yüklemesi tamamlandı ancak zaman dilimi ({self.currently_requested_timeframe}) değiştiği için WS başlatılmıyor.")
            # GUI elemanını aktif et (başka yükleme başlayacak)
            self.root.after(0, lambda: self.timeframe_combobox.config(state="readonly"))

    # --- WebSocket Metodları ---
    def _init_websocket(self):
        """WebSocket bağlantısını başlatır."""
        base_ws_url = "wss://stream.binance.com:9443/ws" # Temel adresi kullan
        logging.info(f"WebSocket bağlantısı başlatılıyor: {base_ws_url}")
        # websocket.enableTrace(True) # Detaylı loglama KAPATILDI
        self.ws = websocket.WebSocketApp(base_ws_url, # Değiştirildi
                                      on_open=self._on_open,
                                      on_message=self._on_message,
                                      on_error=self._on_error,
                                      on_close=self._on_close)
        # WebSocket'i ayrı bir thread'de çalıştır (ping parametreleri eklendi)
        self.ws_thread = threading.Thread(target=lambda: self.ws.run_forever(sslopt={"cert_reqs": ssl.CERT_NONE}, 
                                                                            ping_interval=60, # 60 saniyede bir ping gönder
                                                                            ping_timeout=20), # 10 saniye yerine 20 saniye bekle
                                        daemon=True)
        self.ws_thread.start()

    def _on_open(self, ws):
        """WebSocket bağlantısı açıldığında çağrılır ve streamlere abone olur."""
        logging.info("WebSocket bağlantısı başarılı (on_open tetiklendi).")
        # Seçili zaman dilimi için TÜM sembollerin kline streamlerine abone ol
        try:
            current_tf = self.selected_timeframe.get() # Mutlaka burada alınmalı
            # subscribe_limit = 5 # Test limiti KALDIRILDI
            symbols_to_subscribe = self.symbols # Tüm semboller
            
            if not symbols_to_subscribe:
                logging.warning("Abone olunacak sembol bulunamadı.")
                return
                
            params = [f"{s.lower()}@kline_{current_tf}" for s in symbols_to_subscribe]
            subscribe_message = {
                "method": "SUBSCRIBE",
                "params": params,
                "id": 1 
            }
            ws.send(json.dumps(subscribe_message))
            logging.info(f"{len(params)} adet stream'e abone olundu ({current_tf}).") # Log mesajı güncellendi
        except Exception as e:
            logging.error(f"WebSocket abone olma hatası: {e}", exc_info=True)

    def _on_message(self, ws, message):
        """WebSocket'ten mesaj geldiğinde çağrılır."""
        # print(f"****** _ON_MESSAGE CALLED! Raw message start: {message[:100]}...") # KALDIRILDI
        # Durdurma işareti set edilmişse işlem yapma
        if self.stop_ws_flag.is_set():
            return

        # Ana hata yakalama bloğu (Kalsın)
        try: 
            # print("--- Inside outer try block ---") # KALDIRILDI

            # --- ORİJİNAL İŞLEME (YENİ FORMATLA) --- 
            try:
                # print("--- Inside inner try block ---") # KALDIRILDI
                data = json.loads(message)
                # print(f"--- JSON loaded successfully. Keys: {list(data.keys())}") # KALDIRILDI

                # === FORMAT KONTROLÜ DEĞİŞTİRİLDİ ===
                # if 'stream' in data and '@kline_' in data['stream'] and 'data' in data: # ESKİ KONTROL
                #     kline_data = data['data'] # ESKİ
                #     if kline_data.get('e') == 'kline': # ESKİ
                if data.get('e') == 'kline': # YENİ KONTROL: Olay tipi 'kline' mı?
                    # print("--- Event type is 'kline' ---") # KALDIRILDI
                    k = data.get('k') # YENİ: Kline verisi 'k' anahtarında
                    symbol = data.get('s') # YENİ: Sembol 's' anahtarında
                    if k is None or symbol is None:
                        logging.warning(f"Gelen kline mesajında 'k' veya 's' anahtarı eksik: {data}")
                        return
                        
                    # === /FORMAT KONTROLÜ DEĞİŞTİRİLDİ ===
                        
                    interval = k.get('i')
                    is_closed = k.get('x')
                    msg_timestamp = pd.to_datetime(data.get('E'), unit='ms') # Anahtar 'E'
                    kline_start_time = pd.to_datetime(k.get('t'), unit='ms') # Anahtar 't'
                    
                    if interval is None or is_closed is None or msg_timestamp is None or kline_start_time is None:
                         logging.warning(f"Gelen kline mesajında k['i'], k['x'], data['E'] veya k['t'] anahtarı eksik: {data}")
                         return
                         
                    selected_tf = self.selected_timeframe.get()
                    # logging.debug(f"Kline işleniyor: Sembol={symbol}, Interval={interval}, is_closed={is_closed}, SeçiliTF={selected_tf}") # KALDIRILDI

                    # Sadece seçili zaman dilimi ve takip edilen sembollerle ilgilen
                    if symbol in self.symbols and interval == selected_tf:
                        # logging.debug(f"[{symbol}-{interval}] Sembol ve Zaman Dilimi Eşleşti. İşleme devam ediyor.") # KALDIRILDI

                        # Veri setinde sembol var mı kontrol et
                        if symbol not in self.data or self.data[symbol].empty:
                            return

                        df = self.data[symbol].copy()
                        last_candle_timestamp = df.index[-1]
                        
                        # Gerekli kline değerlerini al (float dönüşümüyle)
                        try:
                            open_price = float(k.get('o', 0.0))
                            high_price = float(k.get('h', 0.0))
                            low_price = float(k.get('l', 0.0))
                            close_price = float(k.get('c', 0.0))
                            volume = float(k.get('v', 0.0))
                        except (ValueError, TypeError) as conv_err:
                            logging.error(f"[{symbol}-{interval}] Kline değerleri float'a çevrilemedi: {k}. Hata: {conv_err}")
                            return
                            
                        new_kline_update = {
                            'open': open_price,
                            'high': high_price,
                            'low': low_price,
                            'close': close_price,
                            'volume': volume
                        }

                        # Mum kapandıysa (is_closed = True):
                        if is_closed:
                            # logging.warning(f"****** [{symbol}-{interval}] MUM KAPANDI! Güncelleme tetiklenmeli! ******") # KALDIRILDI
                            # logging.info(f"[{symbol}-{interval}] Mum kapandı mesajı alındı (is_closed=True). Zaman: {kline_start_time}") # KALDIRILDI
                            # Gelen mumun başlangıç zamanı bizim son mumumuzla aynı mı?
                            if kline_start_time == last_candle_timestamp:
                                # Son mumu gelen kapanış verisiyle güncelle
                                df.loc[last_candle_timestamp, list(new_kline_update.keys())] = list(new_kline_update.values())
                                self.data[symbol] = df # Güncellenmiş DataFrame'i sakla
                                self._recalculate_symbol(symbol, is_closed=True)
                            # Gelen mum bizim son mumumuzdan yeni mi?
                            elif kline_start_time > last_candle_timestamp:
                                # Yeni bir mum geldi, eskisini atıp yenisini ekle
                                new_df_row = pd.DataFrame([new_kline_update], index=[kline_start_time])
                                self.data[symbol] = pd.concat([df.iloc[1:], new_df_row])
                                self._recalculate_symbol(symbol, is_closed=True)
                            else:
                                # Çok eski bir kapanış mesajı, atla
                                logging.warning(f"{symbol} ({interval}): Eski kapanmış mum ({kline_start_time}) alındı, işlenmedi. Son mum: {last_candle_timestamp}")
                        
                        # Mum henüz kapanmadıysa (is_closed = False):
                        else:
                            # Gelen güncelleme bizim son mumumuza mı ait?
                            if kline_start_time == last_candle_timestamp:
                                # Son satırı gelen anlık verilerle güncelle
                                df.loc[last_candle_timestamp, 'open'] = new_kline_update['open']
                                df.loc[last_candle_timestamp, 'high'] = max(df.loc[last_candle_timestamp, 'high'], new_kline_update['high'])
                                df.loc[last_candle_timestamp, 'low'] = min(df.loc[last_candle_timestamp, 'low'], new_kline_update['low'])
                                df.loc[last_candle_timestamp, 'close'] = new_kline_update['close']
                                df.loc[last_candle_timestamp, 'volume'] = new_kline_update['volume']
                                self.data[symbol] = df # Güncellenmiş DataFrame'i sakla
                                # _recalculate_symbol çağrısı burada YOK (sadece kapalıda güncelliyoruz)
                            else:
                                # Henüz başlamamış bir mum için güncelleme?
                                logging.debug(f"{symbol} ({interval}): Kapanmamış mum ({kline_start_time}) için güncelleme alındı ama son mum ({last_candle_timestamp}) farklı. Mum başlangıcı olarak kabul ediliyor.")
                                # Yeni bir mum geldi, eskisini atıp yenisini ekle
                                new_df_row = pd.DataFrame([new_kline_update], index=[kline_start_time])
                                self.data[symbol] = pd.concat([df.iloc[1:], new_df_row])
                    # else: # Bu blok artık if symbol in self.symbols... bloğunun dışında olmalı
                        # print(f"--- Symbol/Timeframe mismatch: {symbol} vs tracked, {interval} vs {selected_tf} ---") 

            except json.JSONDecodeError:
                 logging.error(f"Geçersiz JSON mesajı alındı: {message}", exc_info=True) 
            except KeyError as ke:
                logging.error(f"Gelen mesajda beklenen anahtar bulunamadı: {ke}. Mesaj: {data}", exc_info=True)
            except Exception as e:
                logging.error(f"Inner try block error in _on_message: {e}", exc_info=True)

        except Exception as outer_e:
            print(f"!!!!!!!! FATAL ERROR in _on_message (outer try): {outer_e} !!!!!!!!")
            import traceback
            traceback.print_exc() 
        # --- /ORİJİNAL İŞLEME ---

    def _on_error(self, ws, error):
        """WebSocket hatası oluştuğunda çağrılır."""
        logging.error(f"WebSocket Hatası: {error}", exc_info=True) # exc_info ekle

    def _on_close(self, ws, close_status_code, close_msg):
        """WebSocket bağlantısı kapandığında çağrılır."""
        # Eğer biz kapatmadıysak (beklenmedik kapanma) yeniden bağlanmayı dene
        if not self.stop_ws_flag.is_set():
            logging.warning(f"WebSocket bağlantısı beklenmedik şekilde kapandı. Kod: {close_status_code}, Mesaj: {close_msg}. 5 saniye içinde yeniden bağlanılacak...")
            # GUI hala çalışıyorsa yeniden bağlanmayı planla
            if self.root and self.root.winfo_exists():
                # Yeniden bağlanmadan önce mevcut thread'in tamamen bittiğinden emin ol (isteğe bağlı ama güvenli)
                if self.ws_thread and self.ws_thread.is_alive():
                    try:
                        # Kısa bir süre bekle, belki kendiliğinden biter
                        self.ws_thread.join(timeout=1.0) 
                    except Exception as join_err:
                         logging.error(f"WS thread join hatası (yeniden bağlanma öncesi): {join_err}")
                self.ws = None # WS nesnesini temizle
                self.ws_thread = None # Thread nesnesini temizle
                # Yeniden bağlanma işlemini ana GUI thread'ine gönder
                self.root.after(5000, self._init_websocket) # 5 saniye sonra tekrar dene
            else:
                logging.warning("GUI penceresi kapalı olduğu için yeniden bağlanma işlemi iptal edildi.")
        else:
            logging.info(f"WebSocket bağlantısı kapatıldı (istek üzerine). Kod: {close_status_code}, Mesaj: {close_msg}")

    def _recalculate_symbol(self, symbol: str, is_closed: bool, is_initial_load: bool = False):
        """Belirli bir sembol için tüm hesaplamaları yapar ve durumu günceller.
        
        Args:
            symbol (str): Hesaplanacak sembol.
            is_closed (bool): Bu hesaplamanın kapanmış bir mum üzerine mi yapıldığı.
            is_initial_load (bool): Başlangıç yüklemesi sırasında mı çağrıldığı.
        """
        # logging.debug(f"---> _recalculate_symbol çağrıldı: {symbol}, is_closed={is_closed}, is_initial_load={is_initial_load}") # KALDIRILDI
        if symbol not in self.data:
            return
        
        df_full = self.data[symbol].copy() # Hesaplamalar için kopya alalım
        current_time = datetime.now() 
        
        # --- Hedef Kontrolü --- (Her zaman yapılabilir)
        if symbol in self.active_signals_to_track:
            track_info = self.active_signals_to_track[symbol]
            target_price = track_info['target_price']
            # Son 10 mumun high değerlerine bakalım (daha güvenli olması için)
            lookback_period = 10 
            recent_highs = df_full['high'].iloc[-lookback_period:] 
            achieved_price = recent_highs[recent_highs >= target_price].max()
            
            # Detaylı Loglama Eklendi
            logging.debug(f"[{symbol}] Hedef Kontrol: Takip Aktif. Hedef={target_price:.5f}, "
                          f"Son {lookback_period} Highs={list(recent_highs.round(5))}, "
                          f"Ulaşılan Max High={achieved_price if pd.notna(achieved_price) else 'Yok'}")

            if pd.notna(achieved_price):
                logging.info(f"[{symbol}] +%1 HEDEFİNE ULAŞILDI! Hedef: {target_price:.5f}, Ulaşılan: {achieved_price:.5f}")
                signal_db_id = track_info.get('db_id')
                outcome_timestamp = current_time 
                time_diff = (outcome_timestamp - track_info['signal_time']).total_seconds()
                if signal_db_id is not None:
                     logging.info(f"[{symbol}] Sonuç veritabanına loglanıyor ve durum 'COMPLETED' olarak güncelleniyor (ID: {signal_db_id}).")
                     self.log_outcome_to_db(signal_db_id, outcome_timestamp, achieved_price, time_diff)
                     self.update_signal_status(signal_db_id, 'COMPLETED')
                     if symbol in self.active_signals_to_track:
                         # Başarıyla tamamlandığı için takipten çıkar
                         del self.active_signals_to_track[symbol]
                         logging.info(f"[{symbol}] Aktif takiplerden çıkarıldı.")
                else:
                    logging.warning(f"[{symbol}] Sonuç loglanamadı, DB ID bulunamadı. Takip devam ediyor olabilir.")
            # else: # Hedefe henüz ulaşılmadıysa (Debug logu yukarıda zaten var)
            #    pass 
        # -----------------------
        
        # --- Ana Hesaplamalar --- 
        # PineScript mantığı genellikle kapanmış barlara bakar. 
        # Sinyal ve oran hesaplamaları için bir önceki bara kadar olan veriyi kullan.
        if len(df_full) < 2: return 
        df_closed = df_full.iloc[:-1].copy() 
        df_closed.name = symbol 

        min_len_for_calc = max(self.period, self.z_score_length) + 1 
        if len(df_closed) >= min_len_for_calc: 
            # 1. Hesaplamaları kapalı mumlara göre yap ve sakla
            ratios = self.calculate_ratios(df_closed) 
            signals = self.calculate_signals(df_closed) # Temel sinyaller df_closed'dan
            confirmation = self.check_confirmation(df_full) # Teyit df_full'dan
            signals['confirmation'] = confirmation 
            zscore_closed = self.calculate_zscore(df_closed) # Kapalı mum Z-skoru
            
            score_closed = 0.0 
            if self.use_zscore:
                score_closed = zscore_closed 
            else:
                score_closed = ratios.get('score_raw', 0.0) 
            
            self.scores[symbol] = score_closed if pd.notna(score_closed) else 0.0
            self.ratios[symbol] = ratios 
            self.signals[symbol] = signals # confirmation dahil

            # --- Sinyal Teyidi, Loglama ve Takip (SADECE MUM KAPANDIYSA) ---
            if is_closed:
                matched_symbols, score_ranks, ratio_ranks = self.sort_symbols()
                has_base_signal_raw = signals.get('c20l_signal', False) or signals.get('c10l_signal', False)
                is_rank_matched = symbol in matched_symbols

                # Get confirmation details
                confirmation_details = signals.get('confirmation', {})
                volume_ok = confirmation_details.get('volume_perc_change_ok', False)
                momentum_ok = confirmation_details.get('confirm_momentum_positive', False)

                # --- Define Confirmation Types ---
                is_fully_confirmed = volume_ok and momentum_ok
                is_volume_only_confirmed = volume_ok and not momentum_ok

                # --- Condition for potential tracking (Base Signal + Rank Match + (Volume OR Full Confirmation)) ---
                has_base_signal_and_rank = has_base_signal_raw and is_rank_matched
                should_consider_tracking = has_base_signal_and_rank and volume_ok # Track if at least volume is OK

                ml_prediction_confirms = True # Default
                ml_status_for_gui = "N/A"     # Default
                confirmation_type_for_log = "" # To store confirmation type if tracked

                # --- ML Prediction (Run if potentially tracking) ---
                if self.ml_model and should_consider_tracking:
                    try:
                        # Prepare features (same features used regardless of V or V+M confirmation for now)
                        features_for_prediction = {
                             'score': score_closed,
                             'signal_ratio': signals.get('diff_percent', 0.0),
                             'signal_volume': confirmation_details.get('signal_volume', 0),
                             'confirm_volume': confirmation_details.get('confirm_volume', 0),
                             'signal_momentum_perc': confirmation_details.get('signal_momentum', 0.0),
                             'confirm_momentum_perc': confirmation_details.get('confirm_momentum', 0.0),
                             'signal_abs_price_change': confirmation_details.get('signal_abs_price_change', 0.0),
                             'confirm_abs_price_change': confirmation_details.get('confirm_abs_price_change', 0.0),
                             'volume_ok': 1 if confirmation_details.get('volume_ok', False) else 0, # Original volume check
                             'momentum_perc_ok': 1 if confirmation_details.get('momentum_ok', False) else 0, # Original momentum check
                             'momentum_abs_ok': 1 if confirmation_details.get('abs_momentum_ok', False) else 0,
                             # 'is_confirmed_orig' might need adjustment based on how ML was trained
                             'is_confirmed_orig': 1 if is_fully_confirmed else 0, # Pass full confirmation status
                         }
                        if hasattr(self.ml_model, 'feature_names_in_'):
                            feature_values = [features_for_prediction[feat] for feat in self.ml_model.feature_names_in_]
                            features_df = pd.DataFrame([feature_values], columns=self.ml_model.feature_names_in_)
                        else:
                             logging.warning(f"[{symbol}] ML model does not have feature_names_in_. Using predefined order (may be risky).")
                             fallback_features = [
                                'score', 'signal_ratio', 'signal_volume', 'confirm_volume',
                                'signal_momentum_perc', 'confirm_momentum_perc', 'signal_abs_price_change', 'confirm_abs_price_change',
                                'volume_ok', 'momentum_perc_ok', 'momentum_abs_ok', 'is_confirmed_orig'
                             ]
                             feature_values = [features_for_prediction[feat] for feat in fallback_features]
                             features_df = pd.DataFrame([feature_values], columns=fallback_features)

                        probabilities = self.ml_model.predict_proba(features_df)
                        probability_of_success = probabilities[0][1]
                        logging.info(f"[{symbol}] ML Prediction (considering Volume OK): Success Probability = {probability_of_success:.4f} (Threshold: {self.ML_CONFIDENCE_THRESHOLD})")

                        if probability_of_success >= self.ML_CONFIDENCE_THRESHOLD:
                            ml_prediction_confirms = True
                            ml_status_for_gui = "ML OK"
                        else:
                            ml_prediction_confirms = False
                            ml_status_for_gui = "ML Rejected"

                    except Exception as ml_err:
                         logging.error(f"[{symbol}] ML prediction error: {ml_err}", exc_info=True)
                         ml_prediction_confirms = False
                         ml_status_for_gui = "ML Error"

                self.ml_predictions[symbol] = ml_status_for_gui if self.ml_model else "ML N/A"

                # --- Tracking Decision (Handle both confirmation types) ---
                should_track = False
                if has_base_signal_and_rank and ml_prediction_confirms:
                    if is_fully_confirmed:
                        should_track = True
                        confirmation_type_for_log = "Tam (V+M)"
                    elif is_volume_only_confirmed:
                        should_track = True
                        confirmation_type_for_log = "Hacim (V)"

                if should_track:
                    if symbol not in self.active_signals_to_track:
                        signal_time = current_time
                        signal_price = df_full['close'].iloc[-1]
                        signal_type = 'C20L' if signals.get('c20l_signal', False) else 'C10L'

                        if pd.notna(signal_price) and signal_price > 0:
                            log_details = signals.copy()
                            signal_db_id = self.log_signal_to_db(symbol, signal_type, signal_time, log_details)
                            if signal_db_id is not None:
                                target_price = signal_price * 1.01
                                logging.info(f"[{symbol}] Onaylı ({confirmation_type_for_log} OK, ML OK) {signal_type} sinyali! Fiyat: {signal_price:.4f}, Hedef: {target_price:.4f}. DB ID: {signal_db_id}. Takibe alınıyor.")
                                self.active_signals_to_track[symbol] = {
                                    'target_price': target_price,
                                    'signal_time': signal_time,
                                    'signal_price': signal_price,
                                    'signal_type': signal_type,
                                    'db_id': signal_db_id,
                                    'confirmation_type': confirmation_type_for_log # Optional: Store type
                                }
                                self.update_signal_history(symbol, signals)
                            else:
                                 logging.warning(f"[{symbol}] Sinyal ({confirmation_type_for_log} OK) veritabanına loglanamadı, takip başlatılamadı.")
                        else:
                             logging.warning(f"[{symbol}] Sinyal ({confirmation_type_for_log} OK) fiyatı ({signal_price}) geçersiz olduğu için takip başlatılamadı.")
                    # else: Already tracking

                # --- Logging for other scenarios ---
                elif should_consider_tracking and not ml_prediction_confirms: # Had volume OK but ML rejected
                     log_confirm_type = "Tam (V+M)" if is_fully_confirmed else "Hacim (V)"
                     logging.info(f"[{symbol}] Sinyal bulundu ({log_confirm_type} OK), ancak ML modeli reddetti ({ml_status_for_gui}). Takip edilmiyor.")
                elif has_base_signal_and_rank and not volume_ok: # Base signal but volume not OK
                     logging.info(f"[{symbol}] Temel sinyal ve rank eşleşmesi var AMA HACİM KRİTERİ (%+{self.VOLUME_CHANGE_PERC_THRESHOLD}) SAĞLANMADI. "
                                  f"(Gerçekleşen Hacim Değişimi: {confirmation_details.get('volume_change_perc', 0.0):.2f}%)")

                # GUI Update (always run if closed)
                if not is_initial_load:
                     self.root.after(0, self._update_single_symbol_gui, symbol)
        else:
            # Yeterli veri yoksa veya mum kapanmadıysa ML durumu temizle
            self.ml_predictions.pop(symbol, None)
            # Yeterli veri yoksa hesaplama yapma
            pass

    def update_signal_history(self, symbol: str, signals: dict):
        """Sinyal geçmişini güncelle (Takibe alınan sinyalleri ekle)"""
        # Bu fonksiyon _recalculate_symbol içinde, takibe alınan sinyaller için çağrılır.
        current_time = datetime.now().strftime("%H:%M:%S")
        confirmation_details = signals.get('confirmation', {})

        # Gerçek teyit durumunu al
        volume_ok = confirmation_details.get('volume_perc_change_ok', False)
        momentum_ok = confirmation_details.get('confirm_momentum_positive', False)
        volume_ok_char = "✓" if volume_ok else "✗"
        momentum_ok_char = "✓" if momentum_ok else "✗"

        # Teyit metnini oluştur
        confirm_status = f"[V:{volume_ok_char}, M:{momentum_ok_char}]"

        if symbol not in self.signal_history:
            self.signal_history[symbol] = []

        signal_text = None
        if signals.get('c20l_signal', False):
            signal_text = f"C20L {confirm_status}"
        elif signals.get('c10l_signal', False):
            signal_text = f"C10L {confirm_status}"

        # Sadece geçerli bir sinyal metni varsa ve son eklenenle aynı değilse ekle
        if signal_text:
            last_entry = self.signal_history[symbol][-1] if self.signal_history[symbol] else None
            if not last_entry or last_entry[0] != signal_text:
                 # Takibe alındığı için direkt ekle
                 self.signal_history[symbol].append((signal_text, current_time))
                 # Son 10 kaydı tut
                 self.signal_history[symbol] = self.signal_history[symbol][-10:]

    def get_signal_history_text(self, symbol: str) -> str:
        """Sinyal geçmişi metnini oluştur"""
        if symbol not in self.signal_history or not self.signal_history[symbol]:
            return "-"
        recent_signals = self.signal_history[symbol][-3:]
        return " | ".join([f"{signal}({time})" for signal, time in recent_signals])

    def filter_symbols(self, *args):
        """Tarayıcı tablosunu filtreler ve yeniden çizer (Tüm tablo için)"""
        search_text = self.search_var.get().upper()
        
        # Önce mevcut tüm öğeleri temizle
        for item in self.tree_scanner.get_children():
            try: # Öğeyi silerken hata oluşabilir, yakala
                self.tree_scanner.delete(item)
            except tk.TclError:
                logging.warning(f"Treeview öğesi silinirken hata oluştu (muhtemelen zaten silinmiş): {item}")
                pass 
        self.symbol_to_tree_item.clear() # Eşleşmeyi de temizle
            
        displayed_symbols_count = 0
        # Verilerin mevcut olduğundan emin olmak için self.symbols üzerinden git
        for symbol in self.symbols:
            # Sembol için hesaplanmış veri var mı kontrol et
            if symbol not in self.scores or symbol not in self.ratios or symbol not in self.signals:
                continue 
                
            temp_formatted_symbol = f"{symbol}" # Sıra nosu olmadan arama
            if not search_text or search_text in symbol or search_text in temp_formatted_symbol:
                displayed_symbols_count += 1
                # Verileri hazırla
                values = self._prepare_scanner_row_values(symbol, displayed_symbols_count)
                # Öğeyi ekle ve ID'sini sakla
                try:
                    item_id = self.tree_scanner.insert('', 'end', values=values)
                    self.symbol_to_tree_item[symbol] = item_id
                except Exception as e:
                    logging.error(f"Treeview'e {symbol} eklenirken hata: {e}")

    def _prepare_scanner_row_values(self, symbol: str, display_rank: int) -> Tuple:
        """Bir sembol için Treeview satır değerlerini hazırlar."""
        score = self.scores.get(symbol, 0.0)
        ratio_info = self.ratios.get(symbol, {'price_change': 0.0})
        signals = self.signals.get(symbol, {})
        signal_history_str = self.get_signal_history_text(symbol)

        display_score = score
        display_ratio = signals.get('diff_percent', 0.0)

        matched_symbols, score_ranks, ratio_ranks = self.sort_symbols()
        has_base_signal_raw = signals.get('c20l_signal', False) or signals.get('c10l_signal', False)
        is_rank_matched = symbol in matched_symbols
        has_base_signal_and_rank = has_base_signal_raw and is_rank_matched

        confirmation = signals.get('confirmation', {})
        volume_ok = confirmation.get('volume_perc_change_ok', False)
        momentum_ok = confirmation.get('confirm_momentum_positive', False)
        is_fully_confirmed = volume_ok and momentum_ok
        is_volume_only_confirmed = volume_ok and not momentum_ok

        is_currently_tracking = symbol in self.active_signals_to_track
        ml_status = self.ml_predictions.get(symbol, "ML N/A") # ML tahmin durumunu al

        # Status Metnini Oluştur
        status = "Inactive"
        if has_base_signal_and_rank:
            if is_currently_tracking:
                # Determine confirmation type from active_signals_to_track if available
                track_info = self.active_signals_to_track.get(symbol, {})
                confirmation_type = track_info.get('confirmation_type', '') # e.g., "Tam (V+M)" or "Hacim (V)"
                confirm_tag = f"({confirmation_type} OK, {ml_status})" if confirmation_type else f"(ML: {ml_status})" # Fallback if type not stored
                status = f"Tracking {confirm_tag}"
            elif volume_ok: # Has base signal, rank match, volume OK, but not tracking (maybe ML rejected or just confirmed)
                 confirm_status_tag = "(V+M OK)" if is_fully_confirmed else "(V OK)"
                 status = f"Confirmed {confirm_status_tag} ({ml_status})"
                 if ml_status == "ML Rejected":
                      status = f"Confirmed {confirm_status_tag} (ML Rejected)"
                 elif ml_status == "N/A": # Not yet evaluated by ML or no ML model
                      status = f"Confirmed {confirm_status_tag} (ML N/A)"
                 # If ML OK but not tracking, implies it was just confirmed now or DB log failed
            else: # Has base signal and rank match, but volume is not OK
                status = "Active (Waiting Vol)"

        # Signals Metnini Oluştur
        signal_text = "-"
        if has_base_signal_and_rank:
            # Display the actual V/M status regardless of tracking criteria
            vol_ok_char = "✓" if volume_ok else "✗"
            mom_ok_char = "✓" if momentum_ok else "✗"
            sig_type = "C20L" if signals.get('c20l_signal', False) else "C10L"
            signal_text = f"{sig_type} [V:{vol_ok_char}, M:{mom_ok_char}]"

        # Rank Eşleşme Metnini Oluştur
        score_rank = score_ranks.get(symbol, -1)
        ratio_rank = ratio_ranks.get(symbol, -1)
        rank_match_char = " ✓" if score_rank != -1 and score_rank == ratio_rank else ""

        return (
            str(display_rank) if display_rank > 0 else '-',
            symbol,
            f"{display_score:.2f} ({score_rank+1}){rank_match_char}",
            f"{display_ratio:.2f}% ({ratio_rank+1})",
            signal_text,
            status,
            signal_history_str
        )

    def _update_single_symbol_gui(self, symbol: str):
        """GUI'de sadece belirli bir sembolün satırını günceller."""
        logging.debug(f"---> _update_single_symbol_gui çağrıldı: {symbol}") # LOG EKLE (DEBUG)
